import alloc::string;
import toml;

fn main() -> i64 {
    i64 text[136] = [116, 105, 116, 108, 101, 32, 61, 32, 34, 82, 97, 122, 34, 10, 101, 110, 97, 98, 108, 101, 100, 32, 61, 32, 116, 114, 117, 101, 10, 112, 111, 114, 116, 115, 32, 61, 32, 91, 56, 48, 44, 32, 52, 52, 51, 93, 10, 91, 115, 101, 114, 118, 101, 114, 93, 10, 104, 111, 115, 116, 32, 61, 32, 34, 49, 50, 55, 46, 48, 46, 48, 46, 49, 34, 10, 91, 91, 112, 101, 101, 114, 115, 93, 93, 10, 110, 97, 109, 101, 32, 61, 32, 34, 97, 108, 112, 104, 97, 34, 10, 108, 97, 116, 101, 110, 99, 121, 32, 61, 32, 49, 46, 50, 53, 10, 99, 114, 101, 97, 116, 101, 100, 32, 61, 32, 50, 48, 50, 54, 45, 48, 56, 45, 49, 54, 10];
    String source = alloc::string::from_bytes(&text[0]as usize, 136);
    TomlDocument document = toml::document::empty();
    TomlError error = toml::parser::parse_owned(move source, 64, &mut document);

    if (!toml::error::success(&error)) {
        toml::document::destroy(&mut document);
        return 1;
    }
    if (toml::document::node_count(&document) != 9) {
        toml::document::destroy(&mut document);
        return 2;
    }

    TomlNode*const table = toml::document::node_ptr(&document, 3);
    TomlNode*const array_table = toml::document::node_ptr(&document, 5);

    unsafe {
        if ((*table).kind != TomlNodeKind::Table) {
            toml::document::destroy(&mut document);
            return 3;
        }
        if ((*array_table).kind != TomlNodeKind::ArrayTable) {
            toml::document::destroy(&mut document);
            return 4;
        }
    }
    toml::document::destroy(&mut document);
    return 0;
}
