namespace sqlite::transaction;
import core::result;
import sqlite::connection;
import sqlite::statement;

public enum TransactionMode { Deferred, Immediate, Exclusive }
public struct TransactionError { i64 code; i64 extended_code; }

fn execute_literal(connection::Connection& db, usize sql, i64 length) -> Result<bool, TransactionError> {
    auto prepared = connection::prepare(db, sql, length);
    if (prepared.is_error()) {
        return Result<bool, TransactionError>::Error(TransactionError { code: -1, extended_code: -1 });
    }
    statement::Statement stmt = prepared.unwrap();
    auto stepped = statement::step(&stmt);
    statement::finalize(&mut stmt);
    if (stepped.is_error()) {
        return Result<bool, TransactionError>::Error(TransactionError { code: -1, extended_code: -1 });
    }
    return Result<bool, TransactionError>::Ok(stepped.unwrap() == statement::Step::Done);
}

public fn begin(connection::Connection& db, TransactionMode mode) -> Result<bool, TransactionError> {
    if (mode == TransactionMode::Immediate) {
        u8 sql[15] = [66,69,71,73,78,32,73,77,77,69,68,73,65,84,69];
        return execute_literal(db, &sql[0]as usize, 15);
    }
    if (mode == TransactionMode::Exclusive) {
        u8 sql[15] = [66,69,71,73,78,32,69,88,67,76,85,83,73,86,69];
        return execute_literal(db, &sql[0]as usize, 15);
    }
    u8 sql[5] = [66,69,71,73,78];
    return execute_literal(db, &sql[0]as usize, 5);
}
public fn commit(connection::Connection& db) -> Result<bool, TransactionError> {
    u8 sql[6] = [67,79,77,77,73,84];
    return execute_literal(db, &sql[0]as usize, 6);
}
public fn rollback(connection::Connection& db) -> Result<bool, TransactionError> {
    u8 sql[8] = [82,79,76,76,66,65,67,75];
    return execute_literal(db, &sql[0]as usize, 8);
}
