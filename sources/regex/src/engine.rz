namespace regex::engine;

import regex::program;

fn byte_at(usize data, i64 index) -> u8 {
    unsafe {
        return *((data + index)as u8*const);
    }
}

fn load_i64(usize data, i64 index) -> i64 {
    unsafe {
        return *(((data + index * 8))as i64*const);
    }
}

fn store_i64(usize data, i64 index, i64 value) {
    unsafe {
        *(((data + index * 8))as i64*mut) = value;
    }
}

fn class_match(Regex& regex, i64 begin, i64 end, u8 value) -> bool {
    bool negate = false;
    i64 cursor = begin;

    if (cursor < end && byte_at(regex.pattern, cursor) == 94) {
        negate = true;
        cursor += 1;
    }

    bool matched = false;

    while (cursor < end) {
        u8 first = byte_at(regex.pattern, cursor);

        if (first == 92 && cursor + 1 < end) {
            cursor += 1;
            first = byte_at(regex.pattern, cursor);
        }
        if (cursor + 2 < end && byte_at(regex.pattern, cursor + 1) == 45) {
            u8 last = byte_at(regex.pattern, cursor + 2);

            if (value >= first && value <= last) {
                matched = true;
            }
            cursor += 3;
        } else {
            if (value == first) {
                matched = true;
            }
            cursor += 1;
        }
    }
    if (negate) {
        return !matched;
    }
    return matched;
}

struct MatchScratch {
    i64 first[256];
    i64 second[256];
    i64 seen[256];
    i64 first_count;
    i64 second_count;
}

fn clear_seen(MatchScratch&mut scratch, i64 count) {
    i64 i = 0;

    while (i < count) {
        scratch.seen[i] = 0;
        i += 1;
    }
}

fn state_count(MatchScratch& scratch, bool second) -> i64 {
    if (second) {
        return scratch.second_count;
    }
    return scratch.first_count;
}

fn state_at(MatchScratch& scratch, bool second, i64 index) -> i64 {
    if (second) {
        return scratch.second[index];
    }
    return scratch.first[index];
}

fn state_push(MatchScratch&mut scratch, bool second, i64 pc) {
    if (second) {
        if (scratch.second_count < regex::program::MAX_INSTRUCTIONS) {
            scratch.second[scratch.second_count] = pc;
            scratch.second_count += 1;
        }
        return;
    }
    if (scratch.first_count < regex::program::MAX_INSTRUCTIONS) {
        scratch.first[scratch.first_count] = pc;
        scratch.first_count += 1;
    }
}

fn state_clear(MatchScratch&mut scratch, bool second) {
    if (second) {
        scratch.second_count = 0;
    } else {
        scratch.first_count = 0;
    }
}

fn add_state(Regex& regex, i64 pc, i64 position, i64 text_length, MatchScratch&mut scratch, bool second) {
    if (pc < 0 || pc >= regex.instruction_count || scratch.seen[pc] != 0) {
        return;
    }
    scratch.seen[pc] = 1;

    i64 op = regex::program::instruction_op(regex, pc);

    if (op == regex::program::op_split()) {
        add_state(regex, regex::program::instruction_out1(regex, pc), position, text_length, scratch, second);
        add_state(regex, regex::program::instruction_out2(regex, pc), position, text_length, scratch, second);
        return;
    }
    if (op == regex::program::op_bol()) {
        if (position == 0) {
            add_state(
                regex,
                regex::program::instruction_out1(regex, pc),
                position,
                text_length,
                scratch,
                second
            );
        }
        return;
    }
    if (op == regex::program::op_eol()) {
        if (position == text_length) {
            add_state(
                regex,
                regex::program::instruction_out1(regex, pc),
                position,
                text_length,
                scratch,
                second
            );
        }
        return;
    }
    state_push(scratch, second, pc);
}

fn contains_match(Regex& regex, MatchScratch& scratch, bool second) -> bool {
    i64 count = state_count(scratch, second);
    i64 i = 0;

    while (i < count) {
        if (
            regex::program::instruction_op(regex, state_at(scratch, second, i)) == regex::program::op_match()
        ) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn match_from(Regex& regex, usize text, i64 text_length, i64 start, i64&mut end) -> bool {
    MatchScratch scratch;

    scratch.first_count = 0;
    scratch.second_count = 0;
    clear_seen(&mut scratch, regex.instruction_count);
    add_state(regex, regex.start, start, text_length, &mut scratch, false);
    if (contains_match(regex, &scratch, false)) {
        *end = start;
        return true;
    }

    bool current_second = false;
    i64 position = start;

    while (position < text_length && state_count(&scratch, current_second) > 0) {
        bool next_second = !current_second;

        state_clear(&mut scratch, next_second);

        u8 value = byte_at(text, position);

        clear_seen(&mut scratch, regex.instruction_count);

        i64 count = state_count(&scratch, current_second);
        i64 i = 0;

        while (i < count) {
            i64 pc = state_at(&scratch, current_second, i);
            i64 op = regex::program::instruction_op(regex, pc);
            bool consumes = false;

            if (op == regex::program::op_char()) {
                consumes = value == regex::program::instruction_a(regex, pc)as u8;
            } else if (op == regex::program::op_any()) {
                consumes = value != 10;
            } else if (op == regex::program::op_class()) {
                consumes = class_match(
                    regex,
                    regex::program::instruction_a(regex, pc),
                    regex::program::instruction_b(regex, pc),
                    value
                );
            }
            if (consumes) {
                add_state(
                    regex,
                    regex::program::instruction_out1(regex, pc),
                    position + 1,
                    text_length,
                    &mut scratch,
                    next_second
                );
            }
            i += 1;
        }
        position += 1;
        if (contains_match(regex, &scratch, next_second)) {
            *end = position;
            return true;
        }
        current_second = next_second;
    }
    return false;
}

public fn find_from(Regex& regex, usize text, i64 text_length, i64 offset) -> Match {
    if (text == 0 || text_length < 0 || offset < 0 || offset > text_length) {
        return Match {
            matched: false,
            start: -1,
            end: -1
        };
    }

    i64 start = offset;

    while (start <= text_length) {
        i64 end = -1;

        if (match_from(regex, text, text_length, start, &mut end)) {
            return Match {
                matched: true,
                start: start,
                end: end
            };
        }
        start += 1;
    }
    return Match {
        matched: false,
        start: -1,
        end: -1
    };
}

public fn find(Regex& regex, usize text, i64 text_length) -> Match {
    return find_from(regex, text, text_length, 0);
}

public fn is_match(Regex& regex, usize text, i64 text_length) -> bool {
    Match found = find(regex, text, text_length);

    return found.matched;
}
