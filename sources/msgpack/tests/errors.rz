import msgpack::error;
import msgpack::reader;
import msgpack::value;
import msgpack::writer;

fn main() -> i64 {
    u8 truncated[1] = [217];
    MsgpackReader reader = msgpack::reader::create(&truncated[0]as usize, 1);
    MsgpackItem item;

    if (msgpack::reader::next(&mut reader, &mut item) != MsgpackError::UnexpectedEnd) {
        return 1;
    }
    if (msgpack::reader::position(&reader) != 0) {
        return 2;
    }

    u8 unsupported[1] = [193];

    reader = msgpack::reader::create(&unsupported[0]as usize, 1);
    if (msgpack::reader::next(&mut reader, &mut item) != MsgpackError::UnsupportedType) {
        return 3;
    }

    u8 output[1];
    MsgpackWriter writer = msgpack::writer::create(&mut output[0]as usize, 1);

    if (msgpack::writer::unsigned(&mut writer, 1000) != MsgpackError::OutputFull) {
        return 4;
    }
    return 0;
}
