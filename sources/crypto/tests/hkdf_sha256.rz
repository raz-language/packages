import crypto::kdf::hkdf;

fn main() -> i64 {
    u8 ikm[22];
    i64 i = 0;

    while (i < 22) {
        ikm[i] = 0x0b;
        i += 1;
    }

    u8 salt[13] = [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c];
    u8 info[10] = [0xf0, 0xf1, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8, 0xf9];
    u8 output[42];
    u8 expected[42] = [0x3c, 0xb2, 0x5f, 0x25, 0xfa, 0xac, 0xd5, 0x7a, 0x90, 0x43, 0x4f, 0x64, 0xd0, 0x36, 0x2f, 0x2a, 0x2d, 0x2d, 0x0a, 0x90, 0xcf, 0x1a, 0x5a, 0x4c, 0x5d, 0xb0, 0x2d, 0x56, 0xec, 0xc4, 0xc5, 0xbf, 0x34, 0x00, 0x72, 0x08, 0xd5, 0xb8, 0x87, 0x18, 0x58, 0x65];

    if (
        !crypto::kdf::hkdf::derive(
            &salt[0]as usize,
            13,
            &ikm[0]as usize,
            22,
            &info[0]as usize,
            10,
            &mut output[0]as usize,
            42,
        )
    ) {
        return 1;
    }
    i = 0;
    while (i < 42) {
        if (output[i] != expected[i]) {
            return 2;
        }
        i += 1;
    }
    return 0;
}
