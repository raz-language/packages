namespace testing::benchmark;

public struct BenchmarkStats {
    i64 samples;
    i64 minimum_ns;
    i64 maximum_ns;
    f64 mean_ns;
    f64 m2;
}

public fn create() -> BenchmarkStats {
    return BenchmarkStats {
        samples: 0,
        minimum_ns: 9223372036854775807,
        maximum_ns: 0,
        mean_ns: 0.0,
        m2: 0.0
    };
}

/// Adds one non-negative duration using Welford's stable online algorithm.
public fn add(BenchmarkStats&mut stats, i64 nanoseconds) -> bool {
    if (nanoseconds < 0) {
        return false;
    }
    stats.samples += 1;
    if (nanoseconds < stats.minimum_ns) {
        stats.minimum_ns = nanoseconds;
    }
    if (nanoseconds > stats.maximum_ns) {
        stats.maximum_ns = nanoseconds;
    }

    f64 value = nanoseconds as f64;
    f64 delta = value - stats.mean_ns;

    stats.mean_ns += delta / (stats.samples as f64);

    f64 delta2 = value - stats.mean_ns;

    stats.m2 += delta * delta2;
    return true;
}

public fn variance(BenchmarkStats& stats) -> f64 {
    if (stats.samples < 2) {
        return 0.0;
    }
    return stats.m2 / ((stats.samples - 1)as f64);
}

public fn operations_per_second(BenchmarkStats& stats) -> f64 {
    if (stats.mean_ns <= 0.0) {
        return 0.0;
    }
    return 1000000000.0 / stats.mean_ns;
}
