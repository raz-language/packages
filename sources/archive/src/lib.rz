namespace archive;

public import archive::path;
public import archive::tar;
public import archive::zip;

public fn version_major() -> i64 {
    return 0;
}

public fn version_minor() -> i64 {
    return 1;
}

public fn version_patch() -> i64 {
    return 0;
}
