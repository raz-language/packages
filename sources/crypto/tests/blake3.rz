import crypto::hash::blake3;

fn main() -> i64 {
    u8 output[32];
    u8 expected_empty[32] = [0xaf, 0x13, 0x49, 0xb9, 0xf5, 0xf9, 0xa1, 0xa6, 0xa0, 0x40, 0x4d, 0xea, 0x36, 0xdc, 0xc9, 0x49, 0x9b, 0xcb, 0x25, 0xc9, 0xad, 0xc1, 0x12, 0xb7, 0xcc, 0x9a, 0x93, 0xca, 0xe4, 0x1f, 0x32, 0x62];
    u8 abc[3] = [97, 98, 99];
    u8 expected_abc[32] = [0x64, 0x37, 0xb3, 0xac, 0x38, 0x46, 0x51, 0x33, 0xff, 0xb6, 0x3b, 0x75, 0x27, 0x3a, 0x8d, 0xb5, 0x48, 0xc5, 0x58, 0x46, 0x5d, 0x79, 0xdb, 0x03, 0xfd, 0x35, 0x9c, 0x6c, 0xd5, 0xbd, 0x9d, 0x85];

    if (!crypto::hash::blake3::digest(0, 0, &output[0]as usize)) {
        return 1;
    }

    i64 i = 0;

    while (i < 32) {
        if (output[i] != expected_empty[i]) {
            return 2;
        }
        i += 1;
    }
    if (!crypto::hash::blake3::digest(&abc[0]as usize, 3, &output[0]as usize)) {
        return 3;
    }
    i = 0;
    while (i < 32) {
        if (output[i] != expected_abc[i]) {
            return 4;
        }
        i += 1;
    }
    return 0;
}
