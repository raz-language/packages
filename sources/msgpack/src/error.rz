namespace msgpack::error;

public enum MsgpackError {
    None,
    End,
    InvalidInput,
    UnexpectedEnd,
    UnsupportedType,
    LengthOverflow,
    IntegerOverflow,
    DepthExceeded,
    TypeMismatch,
    OutputFull,
}
