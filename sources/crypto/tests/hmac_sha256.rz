import crypto::mac::hmac;

fn main() -> i64 {
    u8 key[20];
    i64 i = 0;

    while (i<20) {
        key[i] = 0x0b;
        i += 1;
    }

    u8 text[8] = [72, 105, 32, 84, 104, 101, 114, 101];
    u8 output[32];
    u8 expected[32] = [0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53, 0x5c, 0xa8, 0xaf, 0xce, 0xaf, 0x0b, 0xf1, 0x2b, 0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7, 0x26, 0xe9, 0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7];

    if (!crypto::mac::hmac::sha256(&key[0]as usize, 20, &text[0]as usize, 8, &output[0]as usize)) {
        return 1;
    }
    i = 0;
    while (i<32) {
        if (output[i] != expected[i]) {
            return 2;
        }
        i += 1;
    }
    return 0;
}
