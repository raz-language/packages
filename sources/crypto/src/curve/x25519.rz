namespace crypto::curve::x25519;
public const i64 KEY_SIZE = 32;
type Field = i64[16];

fn field_zero(Field&mut value) {
    i64 i = 0;

    while (i < 16) {
        value[i] = 0;
        i += 1;
    }
}

fn field_one(Field&mut value) {
    field_zero(value);
    value[0] = 1;
}

fn copy(Field&mut output, Field& input) {
    i64 i = 0;

    while (i < 16) {
        output[i] = input[i];
        i += 1;
    }
}

fn carry(Field&mut value) {
    i64 i = 0;

    while (i < 16) {
        value[i] += 65536;

        i64 c = value[i] >> 16;

        if (i < 15) {
            value[i + 1] += c - 1;
        } else {
            value[0] += 38 * (c - 1);
        }
        value[i] -= c << 16;
        i += 1;
    }
}

fn select(Field&mut p, Field&mut q, i64 bit) {
    i64 mask = ~(bit - 1);
    i64 i = 0;

    while (i < 16) {
        i64 t = mask & (p[i] ^ q[i]);

        p[i] ^= t;
        q[i] ^= t;
        i += 1;
    }
}

fn add(Field&mut output, Field& a, Field& b) {
    i64 i = 0;

    while (i < 16) {
        output[i] = a[i] + b[i];
        i += 1;
    }
}

fn sub(Field&mut output, Field& a, Field& b) {
    i64 i = 0;

    while (i < 16) {
        output[i] = a[i] - b[i];
        i += 1;
    }
}

fn multiply(Field&mut output, Field& a, Field& b) {
    i64 t[31];
    i64 i = 0;

    while (i < 31) {
        t[i] = 0;
        i += 1;
    }
    i = 0;
    while (i < 16) {
        i64 j = 0;

        while (j < 16) {
            t[i + j] += a[i] * b[j];
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < 15) {
        t[i] += 38 * t[i + 16];
        i += 1;
    }
    i = 0;
    while (i < 16) {
        output[i] = t[i];
        i += 1;
    }
    carry(output);
    carry(output);
}

fn square(Field&mut output, Field& a) {
    multiply(output, a, a);
}

fn unpack(Field&mut output, usize input) {
    i64 i = 0;

    while (i < 16) {
        unsafe {
            output[i] =
                (*((input + i * 2)as u8*const)as i64) |
                ((*((input + i * 2 + 1)as u8*const)as i64) << 8);
        }
        i += 1;
    }
    output[15] &= 32767;
}

fn pack(usize output, Field& input) {
    Field t;
    Field m;

    copy(&mut t, input);
    carry(&mut t);
    carry(&mut t);
    carry(&mut t);

    i64 round = 0;

    while (round < 2) {
        m[0] = t[0] - 65517;

        i64 i = 1;

        while (i < 15) {
            m[i] = t[i] - 65535 - ((m[i - 1] >> 16) & 1);
            m[i - 1] &= 65535;
            i += 1;
        }
        m[15] = t[15] - 32767 - ((m[14] >> 16) & 1);

        i64 borrow = (m[15] >> 16) & 1;

        m[14] &= 65535;
        select(&mut t, &mut m, 1 - borrow);
        round += 1;
    }

    i64 i = 0;

    while (i < 16) {
        unsafe {
            *((output + i * 2)as u8*mut) = (t[i] & 255)as u8;
            *((output + i * 2 + 1)as u8*mut) = (t[i] >> 8)as u8;
        }
        i += 1;
    }
}

fn invert(Field&mut output, Field& input) {
    Field c;

    copy(&mut c, input);

    i64 a = 253;

    while (a >= 0) {
        square(&mut c, &c);
        if (a != 2 && a != 4) {
            multiply(&mut c, &c, input);
        }
        a -= 1;
    }
    copy(output, &c);
}

public fn scalar_mult(usize output, usize scalar, usize point) -> bool {
    if (output == 0 || scalar == 0 || point == 0) {
        return false;
    }

    u8 z[32];
    i64 i = 0;

    while (i < 32) {
        unsafe {
            z[i] = *((scalar + i)as u8*const);
        }
        i += 1;
    }
    z[31] = (z[31] & 127) | 64;
    z[0] &= 248;

    Field x;
    Field a;
    Field b;
    Field c;
    Field d;
    Field e;
    Field f;

    unpack(&mut x, point);
    field_one(&mut a);
    field_zero(&mut b);
    copy(&mut b, &x);
    field_zero(&mut c);
    field_one(&mut d);

    i64 bit_index = 254;

    while (bit_index >= 0) {
        i64 bit = ((z[bit_index >> 3] >> (bit_index & 7)) & 1)as i64;

        select(&mut a, &mut b, bit);
        select(&mut c, &mut d, bit);
        add(&mut e, &a, &c);
        sub(&mut a, &a, &c);
        add(&mut c, &b, &d);
        sub(&mut b, &b, &d);
        square(&mut d, &e);
        square(&mut f, &a);
        multiply(&mut a, &c, &a);
        multiply(&mut c, &b, &e);
        add(&mut e, &a, &c);
        sub(&mut a, &a, &c);
        square(&mut b, &a);
        sub(&mut c, &d, &f);

        Field constant121665;

        field_zero(&mut constant121665);
        constant121665[0] = 121665;
        multiply(&mut a, &c, &constant121665);
        add(&mut a, &a, &d);
        multiply(&mut c, &c, &a);
        multiply(&mut a, &d, &f);
        multiply(&mut d, &b, &x);
        square(&mut b, &e);
        select(&mut a, &mut b, bit);
        select(&mut c, &mut d, bit);
        bit_index -= 1;
    }

    Field inverse;

    invert(&mut inverse, &c);
    multiply(&mut a, &a, &inverse);
    pack(output, &a);
    return true;
}

public fn public_key(usize output, usize private_key) -> bool {
    if (output == 0 || private_key == 0) {
        return false;
    }

    u8 base[32];
    i64 i = 0;

    while (i < 32) {
        base[i] = 0;
        i += 1;
    }
    base[0] = 9;
    return scalar_mult(output, private_key, &base[0]as usize);
}

public fn shared_secret(usize output, usize private_key, usize peer_public_key) -> bool {
    return scalar_mult(output, private_key, peer_public_key);
}
