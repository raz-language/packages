namespace sqlite;

public import sqlite::connection;
public import sqlite::statement;
public import sqlite::transaction;

public fn version_major() -> i64 {
    return 0;
}

public fn version_minor() -> i64 {
    return 2;
}

public fn version_patch() -> i64 {
    return 0;
}
