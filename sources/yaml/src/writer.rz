namespace yaml::writer;

import yaml::error;

public struct YamlWriter {
    usize output;
    i64 capacity;
    i64 length;
    YamlError error;
}

fn load(usize address) -> i64 {
    unsafe {
        return (*((address)as u8*const))as i64;
    }
}

fn store(usize address, i64 value) {
    unsafe {
        *((address)as u8*mut) = value as u8;
    }
}

public fn create(usize output, i64 capacity) -> YamlWriter {
    YamlError error = YamlError::None;

    if (capacity < 0 || (capacity > 0 && output == 0)) {
        capacity = 0;
        error = YamlError::InvalidInput;
    }
    return YamlWriter {
        output: output,
        capacity: capacity,
        length: 0,
        error: error,
    };
}

public fn written(YamlWriter& writer) -> i64 {
    return writer.length;
}

public fn error(YamlWriter& writer) -> YamlError {
    return writer.error;
}

fn fail(YamlWriter&mut writer, YamlError error) -> YamlError {
    if (writer.error == YamlError::None) {
        writer.error = error;
    }
    return writer.error;
}

fn append(YamlWriter&mut writer, i64 byte) -> bool {
    if (writer.length >= writer.capacity) {
        fail(writer, YamlError::OutputFull);
        return false;
    }
    store(writer.output + writer.length, byte);
    writer.length += 1;
    return true;
}

fn append_bytes(YamlWriter&mut writer, usize data, i64 length) -> bool {
    if (length < 0 || (length > 0 && data == 0)) {
        fail(writer, YamlError::InvalidInput);
        return false;
    }
    if (length > writer.capacity - writer.length) {
        fail(writer, YamlError::OutputFull);
        return false;
    }

    i64 i = 0;

    while (i < length) {
        append(writer, load(data + i));
        i += 1;
    }
    return true;
}

fn indentation(YamlWriter&mut writer, i64 indent) -> bool {
    if (indent < 0 || indent > 256) {
        fail(writer, YamlError::IndentExceeded);
        return false;
    }
    if (indent > writer.capacity - writer.length) {
        fail(writer, YamlError::OutputFull);
        return false;
    }

    i64 i = 0;

    while (i < indent) {
        append(writer, 32);
        i += 1;
    }
    return true;
}

fn plain(usize data, i64 length, bool key) -> bool {
    if (length <= 0 || data == 0) {
        return false;
    }

    i64 i = 0;

    while (i < length) {
        i64 byte = load(data + i);

        if (byte < 32 || byte > 126 || byte == 35 || (key && byte == 58)) {
            return false;
        }
        i += 1;
    }
    return true;
}

public fn document_start(YamlWriter&mut writer) -> YamlError {
    if (!append(writer, 45) || !append(writer, 45) || !append(writer, 45) || !append(writer, 10)) {
        return writer.error;
    }
    return YamlError::None;
}

public fn document_end(YamlWriter&mut writer) -> YamlError {
    if (!append(writer, 46) || !append(writer, 46) || !append(writer, 46) || !append(writer, 10)) {
        return writer.error;
    }
    return YamlError::None;
}

public fn mapping_plain(
    YamlWriter&mut writer,
    i64 indent,
    usize key,
    i64 key_length,
    usize value,
    i64 value_length
) -> YamlError {
    if (!plain(key, key_length, true) || !plain(value, value_length, false)) {
        return fail(writer, YamlError::UnsupportedFeature);
    }

    i64 required = indent + key_length + 2 + value_length + 1;

    if (required < 0 || required > writer.capacity - writer.length) {
        return fail(writer, YamlError::OutputFull);
    }
    if (
        !indentation(writer, indent) ||
        !append_bytes(writer, key, key_length) ||
        !append(writer, 58) ||
        !append(writer, 32) ||
        !append_bytes(writer, value, value_length) ||
        !append(writer, 10)
    ) {
        return writer.error;
    }
    return YamlError::None;
}

public fn sequence_plain(YamlWriter&mut writer, i64 indent, usize value, i64 value_length) -> YamlError {
    if (!plain(value, value_length, false)) {
        return fail(writer, YamlError::UnsupportedFeature);
    }

    i64 required = indent + 2 + value_length + 1;

    if (required < 0 || required > writer.capacity - writer.length) {
        return fail(writer, YamlError::OutputFull);
    }
    if (
        !indentation(writer, indent) ||
        !append(writer, 45) ||
        !append(writer, 32) ||
        !append_bytes(writer, value, value_length) ||
        !append(writer, 10)
    ) {
        return writer.error;
    }
    return YamlError::None;
}

fn append_quoted(YamlWriter&mut writer, usize value, i64 value_length) -> bool {
    if (value_length < 0 || (value_length > 0 && value == 0)) {
        fail(writer, YamlError::InvalidInput);
        return false;
    }
    if (!append(writer, 34)) {
        return false;
    }

    i64 i = 0;

    while (i < value_length) {
        i64 byte = load(value + i);

        if (byte == 34 || byte == 92) {
            if (!append(writer, 92) || !append(writer, byte)) {
                return false;
            }
        } else if (byte == 10) {
            if (!append(writer, 92) || !append(writer, 110)) {
                return false;
            }
        } else if (byte == 13) {
            if (!append(writer, 92) || !append(writer, 114)) {
                return false;
            }
        } else if (byte == 9) {
            if (!append(writer, 92) || !append(writer, 116)) {
                return false;
            }
        } else if (byte < 32) {
            fail(writer, YamlError::UnsupportedEscape);
            return false;
        } else if (!append(writer, byte)) {
            return false;
        }
        i += 1;
    }
    return append(writer, 34);
}

public fn mapping_string(
    YamlWriter&mut writer,
    i64 indent,
    usize key,
    i64 key_length,
    usize value,
    i64 value_length
) -> YamlError {
    if (!plain(key, key_length, true)) {
        return fail(writer, YamlError::UnsupportedFeature);
    }
    if (
        !indentation(writer, indent) ||
        !append_bytes(writer, key, key_length) ||
        !append(writer, 58) ||
        !append(writer, 32) ||
        !append_quoted(writer, value, value_length) ||
        !append(writer, 10)
    ) {
        return writer.error;
    }
    return YamlError::None;
}

public fn sequence_string(YamlWriter&mut writer, i64 indent, usize value, i64 value_length) -> YamlError {
    if (
        !indentation(writer, indent) ||
        !append(writer, 45) ||
        !append(writer, 32) ||
        !append_quoted(writer, value, value_length) ||
        !append(writer, 10)
    ) {
        return writer.error;
    }
    return YamlError::None;
}
