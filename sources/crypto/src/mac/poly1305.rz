namespace crypto::mac::poly1305;

public const i64 KEY_SIZE = 32;
public const i64 TAG_SIZE = 16;

public struct Poly1305 {
    u64 r[5];
    u64 h[5];
    u32 pad[4];
    u8 buffer[16];
    i64 leftover;
}

fn load_le32(usize input) -> u32 {
    unsafe {
        return (*((input + 0)as u8*const)as u32) |
            ((*((input + 1)as u8*const)as u32) << 8) |
            ((*((input + 2)as u8*const)as u32) << 16) |
            ((*((input + 3)as u8*const)as u32) << 24);
    }
}

fn store_le32(usize output, u32 value) {
    unsafe {
        *((output + 0)as u8*mut) = value as u8;
        *((output + 1)as u8*mut) = (value >> 8)as u8;
        *((output + 2)as u8*mut) = (value >> 16)as u8;
        *((output + 3)as u8*mut) = (value >> 24)as u8;
    }
}

fn blocks(Poly1305&mut ctx, usize input, i64 length, u64 hibit) {
    u64 r0 = ctx.r[0];
    u64 r1 = ctx.r[1];
    u64 r2 = ctx.r[2];
    u64 r3 = ctx.r[3];
    u64 r4 = ctx.r[4];
    u64 s1 = r1 * 5;
    u64 s2 = r2 * 5;
    u64 s3 = r3 * 5;
    u64 s4 = r4 * 5;
    u64 h0 = ctx.h[0];
    u64 h1 = ctx.h[1];
    u64 h2 = ctx.h[2];
    u64 h3 = ctx.h[3];
    u64 h4 = ctx.h[4];
    i64 offset = 0;

    while (offset + 16 <= length) {
        usize m = input + offset;

        h0 += (load_le32(m + 0)as u64) & 0x3ffffff;
        h1 += ((load_le32(m + 3)as u64) >> 2) & 0x3ffffff;
        h2 += ((load_le32(m + 6)as u64) >> 4) & 0x3ffffff;
        h3 += ((load_le32(m + 9)as u64) >> 6) & 0x3ffffff;
        h4 += ((load_le32(m + 12)as u64) >> 8) | hibit;

        u64 d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
        u64 d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
        u64 d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
        u64 d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
        u64 d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;
        u64 c = d0 >> 26;

        h0 = d0 & 0x3ffffff;
        d1 += c;
        c = d1 >> 26;
        h1 = d1 & 0x3ffffff;
        d2 += c;
        c = d2 >> 26;
        h2 = d2 & 0x3ffffff;
        d3 += c;
        c = d3 >> 26;
        h3 = d3 & 0x3ffffff;
        d4 += c;
        c = d4 >> 26;
        h4 = d4 & 0x3ffffff;
        h0 += c * 5;
        c = h0 >> 26;
        h0 &= 0x3ffffff;
        h1 += c;
        offset += 16;
    }
    ctx.h[0] = h0;
    ctx.h[1] = h1;
    ctx.h[2] = h2;
    ctx.h[3] = h3;
    ctx.h[4] = h4;
}

public fn init(Poly1305&mut ctx, usize key) -> bool {
    if (key == 0) {
        return false;
    }
    ctx.r[0] = (load_le32(key + 0)as u64) & 0x3ffffff;
    ctx.r[1] = ((load_le32(key + 3)as u64) >> 2) & 0x3ffff03;
    ctx.r[2] = ((load_le32(key + 6)as u64) >> 4) & 0x3ffc0ff;
    ctx.r[3] = ((load_le32(key + 9)as u64) >> 6) & 0x3f03fff;
    ctx.r[4] = ((load_le32(key + 12)as u64) >> 8) & 0x00fffff;

    i64 i = 0;

    while (i < 5) {
        ctx.h[i] = 0;
        i += 1;
    }
    ctx.pad[0] = load_le32(key + 16);
    ctx.pad[1] = load_le32(key + 20);
    ctx.pad[2] = load_le32(key + 24);
    ctx.pad[3] = load_le32(key + 28);
    ctx.leftover = 0;
    return true;
}

public fn update(Poly1305&mut ctx, usize input, i64 length) -> bool {
    if (length < 0 || (length > 0 && input == 0)) {
        return false;
    }

    i64 offset = 0;

    if (ctx.leftover > 0) {
        i64 want = 16 - ctx.leftover;

        if (want > length) {
            want = length;
        }

        i64 i = 0;

        while (i < want) {
            unsafe {
                ctx.buffer[ctx.leftover + i] = *((input + i)as u8*const);
            }
            i += 1;
        }
        ctx.leftover += want;
        offset += want;
        if (ctx.leftover < 16) {
            return true;
        }
        blocks(ctx, &ctx.buffer[0]as usize, 16, 1 << 24);
        ctx.leftover = 0;
    }

    i64 direct = ((length - offset) / 16) * 16;

    if (direct > 0) {
        blocks(ctx, input + offset, direct, 1 << 24);
        offset += direct;
    }
    while (offset < length) {
        unsafe {
            ctx.buffer[ctx.leftover] = *((input + offset)as u8*const);
        }
        ctx.leftover += 1;
        offset += 1;
    }
    return true;
}

public fn final(Poly1305&mut ctx, usize output) -> bool {
    if (output == 0) {
        return false;
    }
    if (ctx.leftover > 0) {
        ctx.buffer[ctx.leftover] = 1;

        i64 i = ctx.leftover + 1;

        while (i < 16) {
            ctx.buffer[i] = 0;
            i += 1;
        }
        blocks(ctx, &ctx.buffer[0]as usize, 16, 0);
    }

    u64 h0 = ctx.h[0];
    u64 h1 = ctx.h[1];
    u64 h2 = ctx.h[2];
    u64 h3 = ctx.h[3];
    u64 h4 = ctx.h[4];
    u64 c = h1 >> 26;

    h1 &= 0x3ffffff;
    h2 += c;
    c = h2 >> 26;
    h2 &= 0x3ffffff;
    h3 += c;
    c = h3 >> 26;
    h3 &= 0x3ffffff;
    h4 += c;
    c = h4 >> 26;
    h4 &= 0x3ffffff;
    h0 += c * 5;
    c = h0 >> 26;
    h0 &= 0x3ffffff;
    h1 += c;

    u64 g0 = h0 + 5;

    c = g0 >> 26;
    g0 &= 0x3ffffff;

    u64 g1 = h1 + c;

    c = g1 >> 26;
    g1 &= 0x3ffffff;

    u64 g2 = h2 + c;

    c = g2 >> 26;
    g2 &= 0x3ffffff;

    u64 g3 = h3 + c;

    c = g3 >> 26;
    g3 &= 0x3ffffff;

    u64 g4 = h4 + c - (1 << 26);
    u64 mask = (g4 >> 63) - 1;
    u64 inverse = ~mask;

    h0 = (h0 & inverse) | (g0 & mask);
    h1 = (h1 & inverse) | (g1 & mask);
    h2 = (h2 & inverse) | (g2 & mask);
    h3 = (h3 & inverse) | (g3 & mask);
    h4 = (h4 & inverse) | (g4 & mask);

    u64 w0 = (h0 | (h1 << 26)) & 0xffffffff;
    u64 w1 = ((h1 >> 6) | (h2 << 20)) & 0xffffffff;
    u64 w2 = ((h2 >> 12) | (h3 << 14)) & 0xffffffff;
    u64 w3 = ((h3 >> 18) | (h4 << 8)) & 0xffffffff;
    u64 f0 = w0 + (ctx.pad[0]as u64);
    u64 f1 = w1 + (ctx.pad[1]as u64) + (f0 >> 32);
    u64 f2 = w2 + (ctx.pad[2]as u64) + (f1 >> 32);
    u64 f3 = w3 + (ctx.pad[3]as u64) + (f2 >> 32);

    store_le32(output + 0, f0 as u32);
    store_le32(output + 4, f1 as u32);
    store_le32(output + 8, f2 as u32);
    store_le32(output + 12, f3 as u32);
    return true;
}

public fn authenticate(usize key, usize input, i64 length, usize output) -> bool {
    Poly1305 ctx;

    if (!init(&mut ctx, key) || !update(&mut ctx, input, length)) {
        return false;
    }
    return final(&mut ctx, output);
}
