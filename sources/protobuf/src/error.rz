namespace protobuf::error;

public enum ProtobufError {
    None,
    End,
    InvalidInput,
    UnexpectedEnd,
    InvalidVarint,
    InvalidFieldNumber,
    InvalidWireType,
    GroupsUnsupported,
    LengthOverflow,
    TypeMismatch,
    OutputFull,
}
