namespace datetime::calendar;

public struct Date {
    i64 year;
    i64 month;
    i64 day;
}

public fn is_leap_year(i64 year) -> bool {
    if (year % 4 != 0) {
        return false;
    }
    if (year % 100 != 0) {
        return true;
    }
    return year % 400 == 0;
}

public fn days_in_month(i64 year, i64 month) -> i64 {
    if (month == 2) {
        if (is_leap_year(year)) {
            return 29;
        }
        return 28;
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30;
    }
    if (month >= 1 && month <= 12) {
        return 31;
    }
    return 0;
}

public fn valid(Date& date) -> bool {
    if (date.month < 1 || date.month > 12) {
        return false;
    }

    i64 limit = days_in_month(date.year, date.month);

    return date.day >= 1 && date.day <= limit;
}

fn floor_div(i64 value, i64 divisor) -> i64 {
    i64 quotient = value / divisor;
    i64 remainder = value % divisor;

    if (remainder < 0) {
        quotient -= 1;
    }
    return quotient;
}

public fn to_unix_days(Date& date) -> i64 {
    i64 year = date.year;
    i64 month = date.month;
    i64 day = date.day;

    if (month <= 2) {
        year -= 1;
    }

    i64 era = floor_div(year, 400);
    i64 year_of_era = year - era * 400;
    i64 shifted_month = month + 9;

    if (month > 2) {
        shifted_month = month - 3;
    }

    i64 day_of_year = (153 * shifted_month + 2) / 5 + day - 1;
    i64 day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;

    return era * 146097 + day_of_era - 719468;
}

public fn from_unix_days(i64 days) -> Date {
    i64 z = days + 719468;
    i64 era = floor_div(z, 146097);
    i64 day_of_era = z - era * 146097;
    i64 year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    i64 year = year_of_era + era * 400;
    i64 day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    i64 month_prime = (5 * day_of_year + 2) / 153;
    i64 day = day_of_year - (153 * month_prime + 2) / 5 + 1;
    i64 month = month_prime - 9;

    if (month_prime < 10) {
        month = month_prime + 3;
    }
    if (month <= 2) {
        year += 1;
    }
    return Date {
        year: year,
        month: month,
        day: day
    };
}

public fn weekday(Date& date) -> i64 {
    i64 days = to_unix_days(date);
    i64 value = (days + 3) % 7;

    if (value < 0) {
        value += 7;
    }
    return value + 1;
}

public fn day_of_year(Date& date) -> i64 {
    Date jan1 = Date {
        year: date.year,
        month: 1,
        day: 1
    };
    return to_unix_days(date) - to_unix_days(&jan1) + 1;
}

public fn add_days(Date& date, i64 days) -> Date {
    return from_unix_days(to_unix_days(date) + days);
}

public fn compare(Date& left, Date& right) -> i64 {
    if (left.year < right.year) {
        return -1;
    }
    if (left.year > right.year) {
        return 1;
    }
    if (left.month < right.month) {
        return -1;
    }
    if (left.month > right.month) {
        return 1;
    }
    if (left.day < right.day) {
        return -1;
    }
    if (left.day > right.day) {
        return 1;
    }
    return 0;
}
