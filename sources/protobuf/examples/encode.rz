import protobuf::error;
import protobuf::writer;

fn main() -> i64 {
    u8 output[32];
    ProtobufWriter writer = protobuf::writer::create(&mut output[0]as usize, 32);

    if (protobuf::writer::uint64(&mut writer, 1, 42) != ProtobufError::None) {
        return 1;
    }
    return 0;
}
