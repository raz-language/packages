namespace postgres::extended;
import core::result;
import std::net;
import postgres::wire;
import postgres::client;

public enum ExtendedError {
    InvalidState,
    OutputFull,
    Send
}

fn send_frame(client::Client& c, usize data, i64 length) -> Result<bool, ExtendedError> {
    if (std::net::send_all(c.socket, data, length) != length) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    return Result<bool, ExtendedError>::Ok(true);
}

/// Sends Parse + Bind + Describe(statement) + Execute + Sync using one reusable caller buffer.
/// This intentionally does not wait for responses; receive/framing remains independently drivable.
public fn send_text_query(
    client::Client&mut c,
    usize buffer,
    i64 capacity,
    usize statement,
    i64 statement_length,
    usize sql,
    i64 sql_length,
    usize values,
    i64 value_count,
    i64 max_rows,
) -> Result<bool, ExtendedError> {
    if (c.state != client::State::Ready || c.socket < 0) {
        return Result<bool, ExtendedError>::Error(ExtendedError::InvalidState);
    }

    auto frame = wire::write_parse(buffer, capacity, statement, statement_length, sql, sql_length);

    if (frame.is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::OutputFull);
    }
    if (send_frame(c, buffer, frame.unwrap()).is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    frame = wire::write_bind_text(buffer, capacity, 0, 0, statement, statement_length, values, value_count);
    if (frame.is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::OutputFull);
    }
    if (send_frame(c, buffer, frame.unwrap()).is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    frame = wire::write_describe_statement(buffer, capacity, statement, statement_length);
    if (frame.is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::OutputFull);
    }
    if (send_frame(c, buffer, frame.unwrap()).is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    frame = wire::write_execute(buffer, capacity, 0, 0, max_rows);
    if (frame.is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::OutputFull);
    }
    if (send_frame(c, buffer, frame.unwrap()).is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    frame = wire::write_sync(buffer, capacity);
    if (frame.is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::OutputFull);
    }
    if (send_frame(c, buffer, frame.unwrap()).is_error()) {
        return Result<bool, ExtendedError>::Error(ExtendedError::Send);
    }
    c.state = client::State::Querying;
    return Result<bool, ExtendedError>::Ok(true);
}
