namespace crypto::hash::sha3;

public const i64 SHA3_256_SIZE = 32;
public const i64 SHA3_512_SIZE = 64;

public struct Sha3 {
    u64 state[25];
    u8 buffer[144];
    i64 rate;
    i64 buffer_length;
    i64 digest_length;
}

fn rotl(u64 value, i64 amount) -> u64 {
    if (amount == 0) {
        return value;
    }
    return (value << amount) | (value >> (64 - amount));
}

fn keccak_f(Sha3&mut ctx) {
    u64 rc[24] = [0x0000000000000001 as u64, 0x0000000000008082 as u64, 0x800000000000808a as u64, 0x8000000080008000 as u64, 0x000000000000808b as u64, 0x0000000080000001 as u64, 0x8000000080008081 as u64, 0x8000000000008009 as u64, 0x000000000000008a as u64, 0x0000000000000088 as u64, 0x0000000080008009 as u64, 0x000000008000000a as u64, 0x000000008000808b as u64, 0x800000000000008b as u64, 0x8000000000008089 as u64, 0x8000000000008003 as u64, 0x8000000000008002 as u64, 0x8000000000000080 as u64, 0x000000000000800a as u64, 0x800000008000000a as u64, 0x8000000080008081 as u64, 0x8000000000008080 as u64, 0x0000000080000001 as u64, 0x8000000080008008 as u64];
    i64 rho[25] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14];
    i64 round = 0;

    while (round < 24) {
        u64 c[5];
        u64 d[5];
        u64 b[25];
        i64 x = 0;

        while (x < 5) {
            c[x] = ctx.state[x] ^ ctx.state[x + 5] ^ ctx.state[x + 10] ^ ctx.state[x + 15] ^ ctx.state[x + 20];
            x += 1;
        }
        x = 0;
        while (x < 5) {
            d[x] = c[(x + 4) % 5] ^ rotl(c[(x + 1) % 5], 1);
            x += 1;
        }

        i64 y = 0;

        while (y < 5) {
            x = 0;
            while (x < 5) {
                i64 index = x + y * 5;

                ctx.state[index] ^= d[x];
                x += 1;
            }
            y += 1;
        }
        y = 0;
        while (y < 5) {
            x = 0;
            while (x < 5) {
                i64 source = x + y * 5;
                i64 target_x = y;
                i64 target_y = (2 * x + 3 * y) % 5;

                b[target_x + target_y * 5] = rotl(ctx.state[source], rho[source]);
                x += 1;
            }
            y += 1;
        }
        y = 0;
        while (y < 5) {
            x = 0;
            while (x < 5) {
                ctx.state[x + y * 5] = b[x + y * 5] ^ ((~b[((x + 1) % 5) + y * 5]) & b[((x + 2) % 5) + y * 5]);
                x += 1;
            }
            y += 1;
        }
        ctx.state[0] ^= rc[round];
        round += 1;
    }
}

fn absorb_block(Sha3&mut ctx) {
    i64 i = 0;

    while (i < ctx.rate) {
        i64 lane = i / 8;
        i64 shift = (i % 8) * 8;

        ctx.state[lane] ^= (ctx.buffer[i]as u64) << shift;
        i += 1;
    }
    keccak_f(ctx);
}

fn init_common(Sha3&mut ctx, i64 rate, i64 digest_length) {
    i64 i = 0;

    while (i < 25) {
        ctx.state[i] = 0;
        i += 1;
    }
    ctx.rate = rate;
    ctx.buffer_length = 0;
    ctx.digest_length = digest_length;
}

public fn init256(Sha3&mut ctx) {
    init_common(ctx, 136, 32);
}

public fn init512(Sha3&mut ctx) {
    init_common(ctx, 72, 64);
}

public fn update(Sha3&mut ctx, usize input, i64 length) -> bool {
    if (length < 0 || (length > 0 && input == 0)) {
        return false;
    }

    i64 offset = 0;

    while (offset < length) {
        i64 take = ctx.rate - ctx.buffer_length;

        if (take > length - offset) {
            take = length - offset;
        }

        i64 i = 0;

        while (i < take) {
            unsafe {
                ctx.buffer[ctx.buffer_length + i] = *((input + offset + i)as u8*const);
            }
            i += 1;
        }
        ctx.buffer_length += take;
        offset += take;
        if (ctx.buffer_length == ctx.rate) {
            absorb_block(ctx);
            ctx.buffer_length = 0;
        }
    }
    return true;
}

public fn final(Sha3&mut ctx, usize output) -> bool {
    if (output == 0) {
        return false;
    }

    i64 i = ctx.buffer_length;

    ctx.buffer[i] = 0x06;
    i += 1;
    while (i < ctx.rate) {
        ctx.buffer[i] = 0;
        i += 1;
    }
    ctx.buffer[ctx.rate - 1] |= 0x80;
    absorb_block(ctx);
    i = 0;
    while (i < ctx.digest_length) {
        i64 lane = i / 8;
        i64 shift = (i % 8) * 8;

        unsafe {
            *((output + i)as u8*mut) = (ctx.state[lane] >> shift)as u8;
        }
        i += 1;
    }
    return true;
}

public fn digest256(usize input, i64 length, usize output) -> bool {
    Sha3 ctx;

    init256(&mut ctx);
    if (!update(&mut ctx, input, length)) {
        return false;
    }
    return final(&mut ctx, output);
}

public fn digest512(usize input, i64 length, usize output) -> bool {
    Sha3 ctx;

    init512(&mut ctx);
    if (!update(&mut ctx, input, length)) {
        return false;
    }
    return final(&mut ctx, output);
}
