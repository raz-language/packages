import crypto::hash::sha256;

fn main() -> i64 {
    u8 message[3] = [97, 98, 99];
    u8 digest[32];

    if (!crypto::hash::sha256::digest(&message[0]as usize, 3, &digest[0]as usize)) {
        return 1;
    }
    return 0;
}
