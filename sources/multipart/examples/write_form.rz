import multipart::writer;

fn main() -> i64 {
    u8 output[256];
    u8 boundary[8] = [114, 97, 122, 45, 100, 101, 109, 111];
    u8 name[5] = [116, 105, 116, 108, 101];
    u8 value[7] = [101, 120, 97, 109, 112, 108, 101];
    MultipartWriter writer = multipart::writer::create(&mut output[0]as usize, 256, &boundary[0]as usize, 8);

    if (
        multipart::writer::field(
            &mut writer,
            &name[0]as usize,
            5,
            &value[0]as usize,
            7
        ) != MultipartWriteError::None
    ) {
        return 1;
    }
    return multipart::writer::finish(&mut writer) == MultipartWriteError::None?0: 2;
}
