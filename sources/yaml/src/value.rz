namespace yaml::value;

import core::bytes;

public enum YamlLineKind {
    DocumentStart,
    DocumentEnd,
    Mapping,
    Sequence,
    SequenceMapping,
    Scalar,
}

public enum YamlScalarKind {
    Empty,
    String,
    Null,
    Boolean,
    Integer,
    Float,
}

public struct YamlLine {
    YamlLineKind kind;
    YamlScalarKind scalar_kind;
    i64 indent;
    i64 line_number;
    BytesView key;
    BytesView value;
    bool has_value;
}
