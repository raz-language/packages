namespace msgpack::writer;

import msgpack::error;

public struct MsgpackWriter {
    usize output;
    i64 capacity;
    i64 length;
    MsgpackError error;
}

fn store(usize address, u64 value) {
    unsafe {
        *((address)as u8*mut) = value as u8;
    }
}

fn load(usize address) -> u64 {
    unsafe {
        return (*((address)as u8*const))as u64;
    }
}

public fn create(usize output, i64 capacity) -> MsgpackWriter {
    MsgpackError error = MsgpackError::None;

    if (capacity < 0 || (capacity > 0 && output == 0)) {
        capacity = 0;
        error = MsgpackError::InvalidInput;
    }
    return MsgpackWriter {
        output: output,
        capacity: capacity,
        length: 0,
        error: error,
    };
}

public fn written(MsgpackWriter& writer) -> i64 {
    return writer.length;
}

public fn error(MsgpackWriter& writer) -> MsgpackError {
    return writer.error;
}

fn fail(MsgpackWriter&mut writer, MsgpackError error) -> MsgpackError {
    if (writer.error == MsgpackError::None) {
        writer.error = error;
    }
    return writer.error;
}

fn append(MsgpackWriter&mut writer, u64 byte) -> bool {
    if (writer.length >= writer.capacity) {
        fail(writer, MsgpackError::OutputFull);
        return false;
    }
    store(writer.output + writer.length, byte);
    writer.length += 1;
    return true;
}

fn append_be(MsgpackWriter&mut writer, u64 value, i64 width) -> bool {
    if (width > writer.capacity - writer.length) {
        fail(writer, MsgpackError::OutputFull);
        return false;
    }

    i64 i = 0;

    while (i < width) {
        append(writer, value >> ((width - i - 1) * 8));
        i += 1;
    }
    return true;
}

public fn null_value(MsgpackWriter&mut writer) -> MsgpackError {
    if (!append(writer, 192)) {
        return writer.error;
    }
    return MsgpackError::None;
}

public fn boolean(MsgpackWriter&mut writer, bool value) -> MsgpackError {
    u64 marker = 194;

    if (value) {
        marker = 195;
    }
    if (!append(writer, marker)) {
        return writer.error;
    }
    return MsgpackError::None;
}

public fn unsigned(MsgpackWriter&mut writer, u64 value) -> MsgpackError {
    if (value <= 127) {
        if (!append(writer, value)) {
            return writer.error;
        }
    } else if (value <= 255) {
        if (!append(writer, 204) || !append_be(writer, value, 1)) {
            return writer.error;
        }
    } else if (value <= 65535) {
        if (!append(writer, 205) || !append_be(writer, value, 2)) {
            return writer.error;
        }
    } else if (value <= 4294967295) {
        if (!append(writer, 206) || !append_be(writer, value, 4)) {
            return writer.error;
        }
    } else if (!append(writer, 207) || !append_be(writer, value, 8)) {
        return writer.error;
    }
    return MsgpackError::None;
}

public fn signed(MsgpackWriter&mut writer, i64 value) -> MsgpackError {
    if (value >= 0) {
        return unsigned(writer, value as u64);
    }
    if (value >= -32) {
        if (!append(writer, (value + 256)as u64)) {
            return writer.error;
        }
    } else if (value >= -128) {
        if (!append(writer, 208) || !append_be(writer, (value & 255)as u64, 1)) {
            return writer.error;
        }
    } else if (value >= -32768) {
        if (!append(writer, 209) || !append_be(writer, (value & 65535)as u64, 2)) {
            return writer.error;
        }
    } else if (value >= -2147483648) {
        if (!append(writer, 210) || !append_be(writer, (value & 4294967295)as u64, 4)) {
            return writer.error;
        }
    } else if (!append(writer, 211) || !append_be(writer, value as u64, 8)) {
        return writer.error;
    }
    return MsgpackError::None;
}

fn byte_value(MsgpackWriter&mut writer, usize data, i64 length, bool string_value) -> MsgpackError {
    if (length < 0 || (length > 0 && data == 0)) {
        return fail(writer, MsgpackError::InvalidInput);
    }
    if (length > 4294967295) {
        return fail(writer, MsgpackError::LengthOverflow);
    }

    i64 header = 0;

    if (string_value && length <= 31) {
        header = 1;
    } else if (length <= 255) {
        header = 2;
    } else if (length <= 65535) {
        header = 3;
    } else {
        header = 5;
    }
    if (header > writer.capacity - writer.length || length > writer.capacity - writer.length - header) {
        return fail(writer, MsgpackError::OutputFull);
    }
    if (string_value && length <= 31) {
        append(writer, (160 + length)as u64);
    } else if (length <= 255) {
        if (string_value) {
            append(writer, 217);
        } else {
            append(writer, 196);
        }
        append_be(writer, length as u64, 1);
    } else if (length <= 65535) {
        if (string_value) {
            append(writer, 218);
        } else {
            append(writer, 197);
        }
        append_be(writer, length as u64, 2);
    } else {
        if (string_value) {
            append(writer, 219);
        } else {
            append(writer, 198);
        }
        append_be(writer, length as u64, 4);
    }

    i64 i = 0;

    while (i < length) {
        append(writer, load(data + i));
        i += 1;
    }
    return MsgpackError::None;
}

public fn string(MsgpackWriter&mut writer, usize data, i64 length) -> MsgpackError {
    return byte_value(writer, data, length, true);
}

public fn binary(MsgpackWriter&mut writer, usize data, i64 length) -> MsgpackError {
    return byte_value(writer, data, length, false);
}

fn collection(MsgpackWriter&mut writer, u64 count, bool map_value) -> MsgpackError {
    if (count <= 15) {
        u64 marker = 144;

        if (map_value) {
            marker = 128;
        }
        if (!append(writer, marker + count)) {
            return writer.error;
        }
    } else if (count <= 65535) {
        u64 marker = 220;

        if (map_value) {
            marker = 222;
        }
        if (!append(writer, marker) || !append_be(writer, count, 2)) {
            return writer.error;
        }
    } else if (count <= 4294967295) {
        u64 marker = 221;

        if (map_value) {
            marker = 223;
        }
        if (!append(writer, marker) || !append_be(writer, count, 4)) {
            return writer.error;
        }
    } else {
        return fail(writer, MsgpackError::LengthOverflow);
    }
    return MsgpackError::None;
}

public fn array(MsgpackWriter&mut writer, u64 count) -> MsgpackError {
    return collection(writer, count, false);
}

public fn map(MsgpackWriter&mut writer, u64 count) -> MsgpackError {
    return collection(writer, count, true);
}

public fn float32_bits(MsgpackWriter&mut writer, u32 bits) -> MsgpackError {
    if (!append(writer, 202) || !append_be(writer, bits as u64, 4)) {
        return writer.error;
    }
    return MsgpackError::None;
}

public fn float64_bits(MsgpackWriter&mut writer, u64 bits) -> MsgpackError {
    if (!append(writer, 203) || !append_be(writer, bits, 8)) {
        return writer.error;
    }
    return MsgpackError::None;
}
