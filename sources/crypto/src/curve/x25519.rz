namespace crypto::curve::x25519;

public const i64 KEY_SIZE = 32;

fn field_zero(i64 value[16]) {
    i64 i = 0;

    while (i < 16) {
        value[i] = 0;
        i += 1;
    }
}

fn field_one(i64 value[16]) {
    field_zero(value);
    value[0] = 1;
}

fn copy(i64 output[16], i64 input[16]) {
    i64 i = 0;

    while (i < 16) {
        output[i] = input[i];
        i += 1;
    }
}

fn carry(i64 value[16]) {
    i64 i = 0;

    while (i < 16) {
        value[i] += 65536;

        i64 c = value[i] >> 16;

        if (i < 15) {
            value[i + 1] += c - 1;
        } else {
            value[0] += 38 * (c - 1);
        }
        value[i] -= c << 16;
        i += 1;
    }
}

fn select(i64 p[16], i64 q[16], i64 bit) {
    i64 mask = ~(bit - 1);
    i64 i = 0;

    while (i < 16) {
        i64 t = mask & (p[i] ^ q[i]);

        p[i] ^= t;
        q[i] ^= t;
        i += 1;
    }
}

fn add(i64 output[16], i64 a[16], i64 b[16]) {
    i64 i = 0;

    while (i < 16) {
        output[i] = a[i] + b[i];
        i += 1;
    }
}

fn sub(i64 output[16], i64 a[16], i64 b[16]) {
    i64 i = 0;

    while (i < 16) {
        output[i] = a[i] - b[i];
        i += 1;
    }
}

fn multiply(i64 output[16], i64 a[16], i64 b[16]) {
    i64 t[31];
    i64 i = 0;

    while (i < 31) {
        t[i] = 0;
        i += 1;
    }
    i = 0;
    while (i < 16) {
        i64 j = 0;

        while (j < 16) {
            t[i + j] += a[i] * b[j];
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while (i < 15) {
        t[i] += 38 * t[i + 16];
        i += 1;
    }
    i = 0;
    while (i < 16) {
        output[i] = t[i];
        i += 1;
    }
    carry(output);
    carry(output);
}

fn square(i64 output[16], i64 a[16]) {
    multiply(output, a, a);
}

fn unpack(i64 output[16], usize input) {
    i64 i = 0;

    while (i < 16) {
        unsafe {
            output[i] =
                (*((input + i * 2)as u8*const)as i64) |
                ((*((input + i * 2 + 1)as u8*const)as i64) << 8);
        }
        i += 1;
    }
    output[15] &= 32767;
}

fn pack(usize output, i64 input[16]) {
    i64 t[16];
    i64 m[16];

    copy(t, input);
    carry(t);
    carry(t);
    carry(t);

    i64 round = 0;

    while (round < 2) {
        m[0] = t[0] - 65517;

        i64 i = 1;

        while (i < 15) {
            m[i] = t[i] - 65535 - ((m[i - 1] >> 16) & 1);
            m[i - 1] &= 65535;
            i += 1;
        }
        m[15] = t[15] - 32767 - ((m[14] >> 16) & 1);

        i64 borrow = (m[15] >> 16) & 1;

        m[14] &= 65535;
        select(t, m, 1 - borrow);
        round += 1;
    }

    i64 i = 0;

    while (i < 16) {
        unsafe {
            *((output + i * 2)as u8*mut) = (t[i] & 255)as u8;
            *((output + i * 2 + 1)as u8*mut) = (t[i] >> 8)as u8;
        }
        i += 1;
    }
}

fn invert(i64 output[16], i64 input[16]) {
    i64 c[16];

    copy(c, input);

    i64 a = 253;

    while (a >= 0) {
        square(c, c);
        if (a != 2 && a != 4) {
            multiply(c, c, input);
        }
        a -= 1;
    }
    copy(output, c);
}

public fn scalar_mult(usize output, usize scalar, usize point) -> bool {
    if (output == 0 || scalar == 0 || point == 0) {
        return false;
    }

    u8 z[32];
    i64 i = 0;

    while (i < 32) {
        unsafe {
            z[i] = *((scalar + i)as u8*const);
        }
        i += 1;
    }
    z[31] = (z[31] & 127) | 64;
    z[0] &= 248;

    i64 x[16];
    i64 a[16];
    i64 b[16];
    i64 c[16];
    i64 d[16];
    i64 e[16];
    i64 f[16];

    unpack(x, point);
    field_one(a);
    field_zero(b);
    copy(b, x);
    field_zero(c);
    field_one(d);

    i64 bit_index = 254;

    while (bit_index >= 0) {
        i64 bit = ((z[bit_index >> 3] >> (bit_index & 7)) & 1)as i64;

        select(a, b, bit);
        select(c, d, bit);
        add(e, a, c);
        sub(a, a, c);
        add(c, b, d);
        sub(b, b, d);
        square(d, e);
        square(f, a);
        multiply(a, c, a);
        multiply(c, b, e);
        add(e, a, c);
        sub(a, a, c);
        square(b, a);
        sub(c, d, f);

        i64 constant121665[16];

        field_zero(constant121665);
        constant121665[0] = 121665;
        multiply(a, c, constant121665);
        add(a, a, d);
        multiply(c, c, a);
        multiply(a, d, f);
        multiply(d, b, x);
        square(b, e);
        select(a, b, bit);
        select(c, d, bit);
        bit_index -= 1;
    }

    i64 inverse[16];

    invert(inverse, c);
    multiply(a, a, inverse);
    pack(output, a);
    return true;
}

public fn public_key(usize output, usize private_key) -> bool {
    if (output == 0 || private_key == 0) {
        return false;
    }

    u8 base[32];
    i64 i = 0;

    while (i < 32) {
        base[i] = 0;
        i += 1;
    }
    base[0] = 9;

    usize base_address = &base[0]as usize;

    return scalar_mult(output, private_key, base_address);
}

public fn shared_secret(usize output, usize private_key, usize peer_public_key) -> bool {
    return scalar_mult(output, private_key, peer_public_key);
}
