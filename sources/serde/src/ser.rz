namespace serde::ser;
import alloc::string;
public import serde::error;
// Format implementations provide this allocation-neutral event sink. Compound
// values are emitted in order; formats may stream directly to an io::Write
// adapter rather than building an intermediate tree.
public trait Serializer {
    fn write_null(Self&mut self) -> SerdeError;
    fn write_bool(Self&mut self, bool value) -> SerdeError;
    fn write_i64(Self&mut self, i64 value) -> SerdeError;
    fn write_u64(Self&mut self, u64 value) -> SerdeError;
    fn write_f64(Self&mut self, f64 value) -> SerdeError;
    fn write_bytes(Self&mut self, usize data, i64 length) -> SerdeError;
    fn write_string(Self&mut self, usize data, i64 length) -> SerdeError;
    fn begin_sequence(Self&mut self, i64 length) -> SerdeError;
    fn end_sequence(Self&mut self) -> SerdeError;
    fn begin_map(Self&mut self, i64 length) -> SerdeError;
    fn write_key(Self&mut self, usize data, i64 length) -> SerdeError;
    fn end_map(Self&mut self) -> SerdeError;
}

public trait Serialize {
    fn serialize(Self& self, dyn Serializer serializer) -> SerdeError;
}

public fn encode<T: Serialize>(T& value, dyn Serializer serializer) -> SerdeError {
    return value.serialize(serializer);
}

impl Serialize for bool {
    fn serialize(bool& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_bool(*self);
    }
}

impl Serialize for i64 {
    fn serialize(i64& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_i64(*self);
    }
}

impl Serialize for u64 {
    fn serialize(u64& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_u64(*self);
    }
}

impl Serialize for i32 {
    fn serialize(i32& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_i64((*self)as i64);
    }
}

impl Serialize for u32 {
    fn serialize(u32& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_u64((*self)as u64);
    }
}

impl Serialize for i16 {
    fn serialize(i16& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_i64((*self)as i64);
    }
}

impl Serialize for u16 {
    fn serialize(u16& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_u64((*self)as u64);
    }
}

impl Serialize for i8 {
    fn serialize(i8& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_i64((*self)as i64);
    }
}

impl Serialize for u8 {
    fn serialize(u8& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_u64((*self)as u64);
    }
}

impl Serialize for f64 {
    fn serialize(f64& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_f64(*self);
    }
}

impl Serialize for f32 {
    fn serialize(f32& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_f64((*self)as f64);
    }
}

impl Serialize for String {
    fn serialize(String& self, dyn Serializer serializer) -> SerdeError {
        return serializer.write_string(self.data, self.length);
    }
}
