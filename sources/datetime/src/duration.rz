namespace datetime::duration;

public struct Duration {
    i64 seconds;
    i64 nanoseconds;
}

fn normalize(i64 seconds, i64 nanoseconds) -> Duration {
    seconds += nanoseconds / 1000000000;
    nanoseconds %= 1000000000;
    if (nanoseconds < 0) {
        nanoseconds += 1000000000;
        seconds -= 1;
    }
    return Duration {
        seconds: seconds,
        nanoseconds: nanoseconds
    };
}

public fn new(i64 seconds, i64 nanoseconds) -> Duration {
    return normalize(seconds, nanoseconds);
}

public fn seconds(i64 value) -> Duration {
    return Duration {
        seconds: value,
        nanoseconds: 0
    };
}

public fn milliseconds(i64 value) -> Duration {
    return normalize(value / 1000, (value % 1000) * 1000000);
}

public fn microseconds(i64 value) -> Duration {
    return normalize(value / 1000000, (value % 1000000) * 1000);
}

public fn nanoseconds(i64 value) -> Duration {
    return normalize(0, value);
}

public fn add(Duration& left, Duration& right) -> Duration {
    return normalize(left.seconds + right.seconds, left.nanoseconds + right.nanoseconds);
}

public fn sub(Duration& left, Duration& right) -> Duration {
    return normalize(left.seconds - right.seconds, left.nanoseconds - right.nanoseconds);
}

public fn compare(Duration& left, Duration& right) -> i64 {
    if (left.seconds < right.seconds) {
        return -1;
    }
    if (left.seconds > right.seconds) {
        return 1;
    }
    if (left.nanoseconds < right.nanoseconds) {
        return -1;
    }
    if (left.nanoseconds > right.nanoseconds) {
        return 1;
    }
    return 0;
}
