namespace yaml::error;

public enum YamlError {
    None,
    End,
    InvalidInput,
    InvalidLineEnding,
    TabIndentation,
    IndentExceeded,
    EmptyKey,
    UnterminatedQuote,
    UnsupportedFeature,
    UnsupportedEscape,
    InvalidInteger,
    IntegerOverflow,
    OutputFull,
}
