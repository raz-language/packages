namespace jwt::error;

public enum JwtError {
    None,
    InvalidInput,
    InvalidFormat,
    InvalidHeader,
    InvalidPayload,
    UnsupportedAlgorithm,
    DisallowedAlgorithm,
    WeakKey,
    TokenTooLarge,
    SignatureMismatch,
    CryptoFailure,
    OutputFull,
    Expired,
    NotYetValid,
    IssuedInFuture,
    InvalidClaims,
    InvalidJwk,
}
