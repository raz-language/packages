namespace datetime::rfc3339;

import datetime::calendar;
import datetime::types;
import datetime::timestamp;

fn byte_at(usize data, i64 index) -> u8 {
    unsafe {
        return *((data + index)as u8*const);
    }
}

fn put(usize output, i64 index, u8 value) {
    unsafe {
        *((output + index)as u8*mut) = value;
    }
}

fn digit(u8 value) -> bool {
    return value >= 48 && value <= 57;
}

fn parse_2(usize data, i64 index, i64&mut output) -> bool {
    u8 a = byte_at(data, index);
    u8 b = byte_at(data, index + 1);

    if (!digit(a) || !digit(b)) {
        return false;
    }
    *output = ((a - 48)as i64) * 10 + (b - 48)as i64;
    return true;
}

fn parse_4(usize data, i64 index, i64&mut output) -> bool {
    i64 value = 0;
    i64 i = 0;

    while (i < 4) {
        u8 b = byte_at(data, index + i);

        if (!digit(b)) {
            return false;
        }
        value = value * 10 + (b - 48)as i64;
        i += 1;
    }
    *output = value;
    return true;
}

public fn parse(usize data, i64 length, OffsetDateTime&mut output) -> bool {
    if (data == 0 || length < 20) {
        return false;
    }

    i64 year = 0;
    i64 month = 0;
    i64 day = 0;
    i64 hour = 0;
    i64 minute = 0;
    i64 second = 0;

    if (
        !parse_4(data, 0, &mut year) ||
        byte_at(data, 4) != 45 ||
        !parse_2(data, 5, &mut month) ||
        byte_at(data, 7) != 45 ||
        !parse_2(data, 8, &mut day)
    ) {
        return false;
    }

    u8 separator = byte_at(data, 10);

    if (separator != 84 && separator != 116) {
        return false;
    }
    if (
        !parse_2(data, 11, &mut hour) ||
        byte_at(data, 13) != 58 ||
        !parse_2(data, 14, &mut minute) ||
        byte_at(data, 16) != 58 ||
        !parse_2(data, 17, &mut second)
    ) {
        return false;
    }

    i64 index = 19;
    i64 nanos = 0;

    if (index < length && byte_at(data, index) == 46) {
        index += 1;

        i64 digits = 0;

        while (index < length && digit(byte_at(data, index))) {
            if (digits >= 9) {
                return false;
            }
            nanos = nanos * 10 + (byte_at(data, index) - 48)as i64;
            digits += 1;
            index += 1;
        }
        if (digits == 0) {
            return false;
        }
        while (digits < 9) {
            nanos *= 10;
            digits += 1;
        }
    }

    UtcOffset offset = datetime::types::utc();

    if (index >= length) {
        return false;
    }

    u8 zone = byte_at(data, index);

    if (zone == 90 || zone == 122) {
        index += 1;
    } else if (zone == 43 || zone == 45) {
        if (index + 6 != length || byte_at(data, index + 3) != 58) {
            return false;
        }

        i64 offset_hour = 0;
        i64 offset_minute = 0;

        if (!parse_2(data, index + 1, &mut offset_hour) || !parse_2(data, index + 4, &mut offset_minute)) {
            return false;
        }
        if (offset_hour > 23 || offset_minute > 59) {
            return false;
        }

        i64 total = offset_hour * 3600 + offset_minute * 60;

        if (zone == 45) {
            total = -total;
        }
        if (!datetime::types::offset_seconds(total, &mut offset)) {
            return false;
        }
        index += 6;
    } else {
        return false;
    }
    if (index != length) {
        return false;
    }
    DateTime value = DateTime {
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: nanos
    };
    if (!datetime::types::valid_datetime(&value)) {
        return false;
    }
    *output = OffsetDateTime {
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        nanosecond: nanos,
        offset_seconds: offset.seconds
    };
    return true;
}

fn write_2(usize output, i64 index, i64 value) {
    put(output, index, (48 + (value / 10))as u8);
    put(output, index + 1, (48 + (value % 10))as u8);
}

fn write_4(usize output, i64 index, i64 value) -> bool {
    if (value < 0 || value > 9999) {
        return false;
    }
    put(output, index, (48 + ((value / 1000) % 10))as u8);
    put(output, index + 1, (48 + ((value / 100) % 10))as u8);
    put(output, index + 2, (48 + ((value / 10) % 10))as u8);
    put(output, index + 3, (48 + (value % 10))as u8);
    return true;
}

public fn format(OffsetDateTime& value, usize output, i64 capacity) -> i64 {
    if (output == 0 || capacity < 20 || !datetime::types::valid_offset_datetime(value)) {
        return -1;
    }
    if (!write_4(output, 0, value.year)) {
        return -1;
    }
    put(output, 4, 45);
    write_2(output, 5, value.month);
    put(output, 7, 45);
    write_2(output, 8, value.day);
    put(output, 10, 84);
    write_2(output, 11, value.hour);
    put(output, 13, 58);
    write_2(output, 14, value.minute);
    put(output, 16, 58);
    write_2(output, 17, value.second);

    i64 index = 19;
    i64 nanos = value.nanosecond;

    if (nanos != 0) {
        if (capacity < index + 10) {
            return -1;
        }
        put(output, index, 46);
        index += 1;

        i64 divisor = 100000000;
        i64 end = index + 9;
        i64 i = 0;

        while (i < 9) {
            put(output, index + i, (48 + ((nanos / divisor) % 10))as u8);
            divisor /= 10;
            i += 1;
        }
        while (end > index && byte_at(output, end - 1) == 48) {
            end -= 1;
        }
        index = end;
    }
    if (value.offset_seconds == 0) {
        if (capacity < index + 1) {
            return -1;
        }
        put(output, index, 90);
        return index + 1;
    }
    if (capacity < index + 6) {
        return -1;
    }

    i64 seconds = value.offset_seconds;

    if (seconds < 0) {
        put(output, index, 45);
        seconds = -seconds;
    } else {
        put(output, index, 43);
    }

    i64 hours = seconds / 3600;
    i64 minutes = (seconds % 3600) / 60;

    write_2(output, index + 1, hours);
    put(output, index + 3, 58);
    write_2(output, index + 4, minutes);
    return index + 6;
}

public fn to_timestamp(OffsetDateTime& value, Timestamp&mut output) -> bool {
    DateTime datetime = DateTime {
        year: value.year,
        month: value.month,
        day: value.day,
        hour: value.hour,
        minute: value.minute,
        second: value.second,
        nanosecond: value.nanosecond
    };
    UtcOffset offset = UtcOffset {
        seconds: value.offset_seconds
    };
    return datetime::timestamp::from_datetime(&datetime, &offset, output);
}

public fn from_timestamp(Timestamp& value, UtcOffset& offset) -> OffsetDateTime {
    DateTime converted = datetime::timestamp::to_datetime(value, offset);

    return OffsetDateTime {
        year: converted.year,
        month: converted.month,
        day: converted.day,
        hour: converted.hour,
        minute: converted.minute,
        second: converted.second,
        nanosecond: converted.nanosecond,
        offset_seconds: offset.seconds
    };
}
