import crypto::secure;

fn main() -> i64 {
    u8 a[4] = [1, 2, 3, 4];
    u8 b[4] = [1, 2, 3, 4];
    u8 c[4] = [1, 2, 3, 5];

    if (!crypto::secure::equal(&a[0]as usize, &b[0]as usize, 4)) {
        return 1;
    }
    if (crypto::secure::equal(&a[0]as usize, &c[0]as usize, 4)) {
        return 2;
    }
    if (!crypto::secure::zeroize(&a[0]as usize, 4)) {
        return 3;
    }

    i64 i = 0;

    while (i<4) {
        if (a[i] != 0) {
            return 4;
        }
        i += 1;
    }
    return 0;
}
