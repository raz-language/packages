namespace cbor::error;

public enum CborError {
    None,
    End,
    InvalidInput,
    UnexpectedEnd,
    InvalidAdditionalInfo,
    IndefiniteUnsupported,
    LengthOverflow,
    IntegerOverflow,
    DepthExceeded,
    TypeMismatch,
    OutputFull,
}
