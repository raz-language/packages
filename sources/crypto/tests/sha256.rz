import crypto::hash::sha256;

fn same(usize value, u8 expected[32]) -> bool {
    i64 i = 0;

    while (i < 32) {
        unsafe {
            if (*((value + i)as u8*const) != expected[i]) {
                return false;
            }
        }
        i += 1;
    }
    return true;
}

fn main() -> i64 {
    u8 output[32];
    u8 abc[3] = [97, 98, 99];
    u8 expected[32] = [0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad];

    if (!crypto::hash::sha256::digest(&abc[0]as usize, 3, &output[0]as usize)) {
        return 1;
    }
    if (!same(&output[0]as usize, expected)) {
        return 2;
    }
    return 0;
}
