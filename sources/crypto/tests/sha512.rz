import crypto::hash::sha512;

fn main() -> i64 {
    u8 abc[3] = [97, 98, 99];
    u8 output[64];
    u8 expected[64] = [0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba, 0xcc, 0x41, 0x73, 0x49, 0xae, 0x20, 0x41, 0x31, 0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2, 0x0a, 0x9e, 0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a, 0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1, 0xa8, 0x36, 0xba, 0x3c, 0x23, 0xa3, 0xfe, 0xeb, 0xbd, 0x45, 0x4d, 0x44, 0x23, 0x64, 0x3c, 0xe8, 0x0e, 0x2a, 0x9a, 0xc9, 0x4f, 0xa5, 0x4c, 0xa4, 0x9f];

    if (!crypto::hash::sha512::digest(&abc[0]as usize, 3, &output[0]as usize)) {
        return 1;
    }

    i64 i = 0;

    while (i<64) {
        if (output[i] != expected[i]) {
            return 2;
        }
        i += 1;
    }
    return 0;
}
