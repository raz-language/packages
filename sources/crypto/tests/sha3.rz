import crypto::hash::sha3;

fn main() -> i64 {
    u8 out256[32];
    u8 out512[64];
    u8 expected256[32] = [0xa7, 0xff, 0xc6, 0xf8, 0xbf, 0x1e, 0xd7, 0x66, 0x51, 0xc1, 0x47, 0x56, 0xa0, 0x61, 0xd6, 0x62, 0xf5, 0x80, 0xff, 0x4d, 0xe4, 0x3b, 0x49, 0xfa, 0x82, 0xd8, 0x0a, 0x4b, 0x80, 0xf8, 0x43, 0x4a];
    u8 expected512[64] = [0xa6, 0x9f, 0x73, 0xcc, 0xa2, 0x3a, 0x9a, 0xc5, 0xc8, 0xb5, 0x67, 0xdc, 0x18, 0x5a, 0x75, 0x6e, 0x97, 0xc9, 0x82, 0x16, 0x4f, 0xe2, 0x58, 0x59, 0xe0, 0xd1, 0xdc, 0xc1, 0x47, 0x5c, 0x80, 0xa6, 0x15, 0xb2, 0x12, 0x3a, 0xf1, 0xf5, 0xf9, 0x4c, 0x11, 0xe3, 0xe9, 0x40, 0x2c, 0x3a, 0xc5, 0x58, 0xf5, 0x00, 0x19, 0x9d, 0x95, 0xb6, 0xd3, 0xe3, 0x01, 0x75, 0x85, 0x86, 0x28, 0x1d, 0xcd, 0x26];

    if (!crypto::hash::sha3::digest256(0, 0, &out256[0]as usize)) {
        return 1;
    }
    if (!crypto::hash::sha3::digest512(0, 0, &out512[0]as usize)) {
        return 2;
    }

    i64 i = 0;

    while (i < 32) {
        if (out256[i] != expected256[i]) {
            return 3;
        }
        i += 1;
    }
    i = 0;
    while (i < 64) {
        if (out512[i] != expected512[i]) {
            return 4;
        }
        i += 1;
    }
    return 0;
}
